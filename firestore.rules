rules_version = '2';

// Firestore Security Rules — this file is what actually protects your users.
// Paste into: Firebase Console → Firestore Database → Rules → Publish.
//
// Without these, a project left in "test mode" lets ANYONE on the internet
// read every name, phone number and email you collect.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {

      // A signed-in user may create ONLY their own document, and only with
      // the expected fields. The email must match their verified auth token,
      // so nobody can plant a record under someone else's address.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(
             ['uid', 'fullName', 'phone', 'email', 'createdAt'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 3
        && request.resource.data.fullName.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 25
        && request.resource.data.email == request.auth.token.email;

      // Users can read and update only their own profile.
      allow read: if request.auth != null && request.auth.uid == userId;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(
             ['uid', 'fullName', 'phone', 'email', 'createdAt']);

      // Deleting profiles is an admin job — do it from the console.
      allow delete: if false;
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
